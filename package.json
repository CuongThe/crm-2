  "scripts": {
    "typeorm": "ts-node -T -P apps/api/tsconfig.app.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/api/src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate apps/api/src/database/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed": "ts-node -T -P apps/api/tsconfig.app.json -r tsconfig-paths/register apps/api/src/database/seed.ts"
  },
  "private": true,
