{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@crm-2/source"],
    "paths": {
      "@crm-2/shared-types": ["./libs/shared/types/src/index.ts"],
      "@crm-2/shared/types": ["./libs/shared/types/src/index.ts"],
      "@crm-2/data-access": ["./libs/web/data-access/src/index.ts"],
      "@crm-2/web/data-access": ["./libs/web/data-access/src/index.ts"]
    }
  }
}
